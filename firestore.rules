rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Game saves collection
    match /saves/{username} {
      allow get, list: if isValidId(username);
      allow create, update: if isValidId(username)
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 64
        && request.resource.data.points is number;
      allow delete: if isValidId(username);
    }
  }
}

